# AT International - LiteSpeed / Apache Routing Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to api scripts, uploads, and assets
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]

  # If existing file or directory exists, serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All other requests route to React single-page app
  RewriteRule ^ index.html [L]
</IfModule>
